# PostgreSQL
DATABASE_URL=postgresql://postgres:password@db:5432/insightiq

# JWT
JWT_SECRET=replace_with_a_strong_secret_at_least_24_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# File storage
UPLOAD_DIR=./data/uploads

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_HOST=0.0.0.0
APP_PORT=8001
